# Eufy Video Stack — Research Environment
# Copy to .env.research and fill in real values. NEVER commit .env.research.

# Device IPs (DHCP reservations recommended)
NVR_IP=
CAMERA_IP=

# NVR/Camera firmware versions (record for reproducibility)
NVR_MODEL=
NVR_FIRMWARE=
CAMERA_MODEL=
CAMERA_FIRMWARE=

# Eufy account (local/streaming account, NOT your main cloud account)
EUFY_STREAM_USER=
EUFY_STREAM_PASS=

# RTSP (fill only after confirmed via research)
# CAMERA_RTSP_URL=rtsp://${EUFY_STREAM_USER}:${EUFY_STREAM_PASS}@${NVR_IP}:554/PLACEHOLDER
# CAMERA_RTSP_URL_SUB=

# ONVIF (fill only after confirmed)
# ONVIF_URL=

# Research host
CAPTURE_HOST_IP=
CAPTURE_IFACE=

# MediaMTX local relay (after pipeline is built)
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_API_PORT=9997

# Recording
RECORDING_DIR=/mnt/encrypted/recordings
SEGMENT_DURATION=600
RETENTION_DAYS=30
DRY_RUN=1
