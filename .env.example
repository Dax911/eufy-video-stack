# Eufy Video Stack - Environment Configuration
# Copy to .env and fill in actual values. Never commit .env to git.

# === UPSTREAM VIDEO SOURCES ===

# Primary stream URL (wide/fixed camera view)
# Format: rtsp://username:password@ip:port/path
UPSTREAM_URL=""

# PTZ camera stream URL (if separate from primary)
UPSTREAM_PTZ_URL=""

# Substream/low-res URL (optional)
UPSTREAM_SUB_URL=""

# === RECORDING ===

# Base directory for recordings (absolute path recommended)
RECORDING_DIR="./recordings"

# Segment duration in seconds (default: 3600 = 1 hour)
SEGMENT_DURATION=3600

# Retention period in days
RETENTION_DAYS=7

# Dry run mode for retention (1 = preview only, 0 = delete)
DRY_RUN=1

# Minimum free space in GB before alerting
MIN_FREE_SPACE_GB=50

# Maximum segment age in minutes before considering stale
MAX_SEGMENT_AGE_MINUTES=5

# === MEDIAMTX ===

RELAY_PATH_MAIN="eufy"
RELAY_PATH_PTZ="eufy_ptz"

# === OBS (local relay, no credentials needed) ===

OBS_SOURCE_MAIN="rtsp://localhost:8554/eufy"
OBS_SOURCE_PTZ="rtsp://localhost:8554/eufy_ptz"
